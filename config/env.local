# Local env settings moved to ../.env (override with ENV_FILE).
# AI_REFEREE_CONFIG=config/ai_referee.json
# LAYER_SEMANTIC_CONFIG=config/layer_semantic.json

# Enable pgvector embedding cache
# SEMANTIC_PG_DSN=postgres://<user>:<password>@localhost:5432/SAO?sslmode=disable
SEMANTIC_EMBEDDING_DIM=768

# Store world state in PostgreSQL
# WORLD_PG_DSN=postgres://<user>:<password>@localhost:5432/SAO?sslmode=disable
WORLD_ID=default
WORLD_DB_MODE=structured

# Optional: override embedding URL/model if needed
# LAYER_EMBEDDING_URL=http://127.0.0.1:11434/v1/embeddings
# LAYER_EMBEDDING_MODEL=nomic-embed-text:latest
